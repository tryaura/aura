{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aura-web",
  "compatibility_date": "2026-08-15",
  // No `main`: this is an assets-only deployment, so no Worker script runs.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
