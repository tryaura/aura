#!/bin/sh
#
# Aura installer.
#
#   curl -fsSL https://tryaura.sh/install | sh
#
# Downloads the release binary matching your platform from GitHub Releases, verifies it against
# the published SHA256SUMS, and installs it. Nothing here runs with elevated privileges and
# nothing is written outside the install directory.
#
# Environment:
#   AURA_INSTALL_DIR   where to install (default: $HOME/.aura/bin)
#   AURA_VERSION       release tag to install (default: latest)

abort() {
  printf 'aura: %s\n' "$1" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || abort "'$1' is required but was not found on PATH."
}

main() {
  set -eu

  REPO="tryaura/aura"
  INSTALL_DIR="${AURA_INSTALL_DIR:-$HOME/.aura/bin}"

  require curl
  require tar

  # ----- platform -----------------------------------------------------------

  os=$(uname -s)
  case "$os" in
    Darwin) os="darwin" ;;
    Linux) os="linux" ;;
    *) abort "unsupported operating system '$os'. Aura ships macOS and Linux binaries; see https://github.com/$REPO/releases" ;;
  esac

  arch=$(uname -m)
  case "$arch" in
    x86_64 | amd64) arch="x64" ;;
    arm64 | aarch64) arch="arm64" ;;
    *) abort "unsupported architecture '$arch'." ;;
  esac

  target="${os}-${arch}"

  # ----- version ------------------------------------------------------------

  version="${AURA_VERSION:-}"

  if [ -z "$version" ]; then
    # Resolve the latest tag from the release redirect rather than the API, which is rate limited
    # for unauthenticated callers.
    resolved=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest" 2>/dev/null) ||
      abort "could not reach GitHub to resolve the latest release."
    version="${resolved##*/}"
  fi

  case "$version" in
    v*) ;;
    '') abort "could not determine a release version to install." ;;
    *) version="v$version" ;;
  esac

  archive="aura-${target}.tar.gz"
  base="https://github.com/$REPO/releases/download/$version"

  # ----- download and verify ------------------------------------------------

  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT INT TERM

  printf 'aura: downloading %s %s\n' "$version" "$target"

  curl -fsSL "$base/$archive" -o "$tmp/$archive" ||
    abort "could not download release asset '$archive' for $version. See https://github.com/$REPO/releases"
  curl -fsSL "$base/SHA256SUMS" -o "$tmp/SHA256SUMS" ||
    abort "could not download SHA256SUMS for $version. Refusing to install unverified binary."

  if command -v sha256sum >/dev/null 2>&1; then
    checksum=$(sha256sum "$tmp/$archive" | cut -d' ' -f1)
  elif command -v shasum >/dev/null 2>&1; then
    checksum=$(shasum -a 256 "$tmp/$archive" | cut -d' ' -f1)
  else
    abort "neither 'sha256sum' nor 'shasum' is available; cannot verify the download."
  fi

  # Exact filename match. A grep pattern would treat the dots in the archive name as wildcards.
  expected=$(awk -v want="$archive" '{ name = $2; sub(/^\*/, "", name); if (name == want) { print $1; exit } }' "$tmp/SHA256SUMS")

  [ -n "$expected" ] || abort "'$archive' is not listed in SHA256SUMS for $version."

  if [ "$checksum" != "$expected" ]; then
    abort "checksum mismatch for $archive.
  expected: $expected
  actual:   $checksum
Do not use this download."
  fi

  printf 'aura: checksum verified\n'

  # ----- install ------------------------------------------------------------

  tar -xzf "$tmp/$archive" -C "$tmp"

  [ -f "$tmp/aura" ] || abort "archive did not contain an 'aura' binary."

  mkdir -p "$INSTALL_DIR"
  mv "$tmp/aura" "$INSTALL_DIR/aura"
  chmod 755 "$INSTALL_DIR/aura"

  printf 'aura: installed to %s/aura\n' "$INSTALL_DIR"

  # ----- PATH ---------------------------------------------------------------

  case ":${PATH}:" in
    *":$INSTALL_DIR:"*)
      printf 'aura: run `aura --version` to get started.\n'
      ;;
    *)
      shell_name="${SHELL:-}"
      shell_name="${shell_name##*/}"

      case "$shell_name" in
        zsh) profile="~/.zshrc" ;;
        bash) profile="~/.bashrc" ;;
        fish) profile="~/.config/fish/config.fish" ;;
        *) profile="your shell profile" ;;
      esac

      printf '\naura: %s is not on your PATH. Add this line to %s:\n\n' "$INSTALL_DIR" "$profile"

      if [ "$shell_name" = "fish" ]; then
        printf '  fish_add_path %s\n\n' "$INSTALL_DIR"
      else
        printf '  export PATH="%s:$PATH"\n\n' "$INSTALL_DIR"
      fi
      ;;
  esac
}

main "$@"
