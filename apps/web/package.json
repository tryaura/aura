{
  "name": "@tryaura/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "deploy": "pnpm migrate:remote && wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "dev": "astro dev",
    "migrate:local": "wrangler d1 migrations apply TELEMETRY_DB --local",
    "migrate:remote": "wrangler d1 migrations apply TELEMETRY_DB --remote",
    "preview": "pnpm migrate:local && astro build && wrangler dev",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "@tryaura/aura-sdk": "workspace:*",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.125.0"
  }
}
