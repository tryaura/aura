{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn"
  },
  "workspaces": {
    "examples/*": {
      "entry": ["src/main.boundary.ts", "src/standalone-main.boundary.ts"]
    },
    "distros/*": {
      "entry": ["src/standalone-main.boundary.ts", "src/**/*.test.ts", "src/**/*.smoke.ts"],
      "includeEntryExports": true
    },
    "packages/sdk": {
      "entry": ["type-tests/*.ts"]
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "packages/cli": {
      "entry": ["type-tests/*.ts"],
      "ignoreDependencies": ["diff", "ignore", "smol-toml", "toml-eslint-parser", "undici"]
    },
    "plugins/*": {
      "includeEntryExports": true
    }
  }
}
