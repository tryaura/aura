{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/fixtures/distro-consumer/smoke.mjs",
        "scripts/fixtures/distro-consumer/src/main.ts",
        "scripts/fixtures/distro-consumer/src/plugin.ts"
      ]
    },
    "distros/*": {
      "entry": ["src/**/*.test.ts", "src/**/*.smoke.ts"],
      "includeEntryExports": true
    },
    "packages/sdk": {
      "entry": ["type-tests/*.ts"]
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "packages/cli": {
      "entry": ["type-tests/*.ts"],
      "ignoreDependencies": [
        "diff",
        "ignore",
        "semver",
        "smol-toml",
        "toml-eslint-parser",
        "undici"
      ]
    },
    "plugins/*": {
      "includeEntryExports": true
    }
  }
}
