{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn"
  },
  "workspaces": {
    "distros/*": {
      "entry": ["src/**/*.test.ts", "src/**/*.smoke.ts"],
      "includeEntryExports": true
    },
    "packages/sdk": {
      "entry": ["type-tests/*.ts"]
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "plugins/*": {
      "includeEntryExports": true
    }
  }
}
