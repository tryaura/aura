{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "optionalPeerDependencies": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "examples/acme-distribution/smoke.mjs",
        "examples/acme-distribution/src/main.ts",
        "examples/acme-distribution/src/plugin.ts"
      ]
    },
    "distros/*": {
      "entry": ["src/**/*.test.ts", "src/**/*.smoke.ts"],
      "includeEntryExports": true
    },
    "packages/sdk": {
      "entry": ["type-tests/*.ts"]
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "packages/cli": {
      "entry": ["type-tests/*.ts"],
      "ignoreDependencies": ["diff", "ignore", "semver", "smol-toml", "undici"]
    },
    "plugins/*": {
      "includeEntryExports": true
    }
  }
}
