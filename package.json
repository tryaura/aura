{
  "name": "aura",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "fallow": "fallow audit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm verify:workflows && pnpm typecheck && pnpm build && pnpm lint && pnpm format:check && pnpm knip && pnpm fallow && pnpm test",
    "verify:binary": "pnpm --filter @tryaura/aura verify:binary",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "fallow": "3.17.0",
    "knip": "6.32.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
