{
  "name": "aura",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fallow": "fallow audit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm fallow && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fallow": "3.16.0",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
