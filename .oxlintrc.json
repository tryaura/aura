{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": false,
        "skipComments": false
      }
    ]
  }
}
