{
  "name": "@tryaura/aura-cli",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema/check-output-v1.json": "./schema/check-output-v1.schema.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./schema/check-output-v1.json": "./schema/check-output-v1.schema.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tryaura/aura-sdk": "workspace:*",
    "@tryaura/content-official": "workspace:*",
    "@tryaura/core": "workspace:*",
    "clipanion": "3.2.1",
    "string-width": "4.2.3",
    "typanion": "3.14.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "vitest": "4.1.10"
  }
}
