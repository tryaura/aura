{
  "name": "@tryaura/aura-sdk",
  "version": "0.5.4",
  "description": "The public plugin API for Aura distributions.",
  "keywords": [
    "agent",
    "aura",
    "plugin",
    "sdk"
  ],
  "homepage": "https://github.com/tryaura/aura/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/tryaura/aura/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryaura/aura.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24"
  }
}
